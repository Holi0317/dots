[user]
  name = Hollis Wu

[core]
  autocrlf = input
  excludesfile = ~/.gitignore
  pager = delta
  fsyncMethod = batch

[init]
  defaultBranch = main

[interactive]
  diffFilter = delta --color-only
[add.interactive]
  useBuiltin = false # required for git 2.37.0

[commit]
  gpgsign = true

[alias]
  co = checkout
  st = status
  cam = commit --amend --no-edit
  cm = commit
  pish = push
  graph = log --graph --abbrev-commit --decorate --format=format:'%C(bold blue)%h%C(reset) - %C(bold cyan)%aD%C(reset) %C(bold green)(%ar)%C(reset)%C(bold yellow)%d%C(reset)%n''          %C(white)%s%C(reset) %C(dim white)- %an%C(reset)' --all
  cp = cherry-pick

[push]
  default = current
  autoSetupRemote = true

[pull]
  ff = only

[merge]
  ff = false
  conflictstyle = diff3
  tool = nvimdiff

[diff]
  colorMoved = default
  tool = nvimdiff
  guitool = nvimdiff
  external = difft

[difftool "nvimdiff"]
  cmd = "nvim -d \"$LOCAL\" \"$REMOTE\""

[rebase]
  autoSquash = true

[gpg "ssh"]
  allowedSignersFile = ~/.config/git/allowed_signers

[filter "lfs"]
  process = git-lfs filter-process
  required = true
  clean = git-lfs clean -- %f
  smudge = git-lfs smudge -- %f

[credential "https://github.com"]
  helper = 
  helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
  helper = 
  helper = !/opt/homebrew/bin/gh auth git-credential

[delta]
  navigate = true  # use n and N to move between diff sections
  light = false    # set to true if you're in a terminal w/ a light background color (e.g. the default macOS terminal)

[hook "hk-commit-msg"]
  command = test \"${HK:-1}\" = \"0\" || ~/.local/share/mise/installs/hk/1.55.0/hk run commit-msg --from-hook
  event = commit-msg
[hook "hk-pre-commit"]
  command = test \"${HK:-1}\" = \"0\" || ~/.local/share/mise/installs/hk/1.55.0/hk run pre-commit --from-hook --staged
  event = pre-commit
[hook "hk-pre-push"]
  command = test \"${HK:-1}\" = \"0\" || ~/.local/share/mise/installs/hk/1.55.0/hk run pre-push --from-hook
  event = pre-push
[hook "hk-prepare-commit-msg"]
  command = test \"${HK:-1}\" = \"0\" || ~/.local/share/mise/installs/hk/1.55.0/hk run prepare-commit-msg --from-hook
  event = prepare-commit-msg

[include]
  path = ~/.gitconfig.local

